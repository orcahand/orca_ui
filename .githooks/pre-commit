#!/bin/sh
# Keeps two local-only things out of shared history: a developer's orca_core
# override, and a stale frontend bundle.

staged=$(git diff --cached --name-only)

# --- dev-mode override -------------------------------------------------------
# `orca-dev local` / `orca-dev branch` point this checkout at an orca_core that
# exists only on this machine. uv has no local-only override file, so that edit
# lands in tracked files, and committed it makes the project unresolvable
# everywhere else.
#
# Detection is done here in shell so it needs nothing installed; python is only
# used to strip the entry, which leaves the working tree in dev mode. An entry
# that cannot be stripped blocks the commit instead of being waved through.
override=""
if echo "$staged" | grep -q '^pyproject\.toml$' && git show :pyproject.toml 2>/dev/null \
   | grep -qE 'tool\.uv\.sources|^[[:space:]]*"?.?orca[-_]core"?.?[[:space:]]*='; then
    override=pyproject.toml
fi
if echo "$staged" | grep -q '^uv\.lock$' && git show :uv.lock 2>/dev/null \
   | grep -q 'source = { editable = "\.\.'; then
    override="${override:+$override, }uv.lock"
fi

if [ -n "$override" ]; then
    PY=""
    [ -x .venv/bin/python ] && PY=.venv/bin/python
    [ -z "$PY" ] && PY=$(command -v python3 || command -v python || true)
    rc=1
    if [ -n "$PY" ]; then
        "$PY" - <<'PYEOF'
import sys
sys.path.insert(0, ".")
try:
    from orca_ui.core_source import precommit_fix
except Exception:
    sys.exit(1)
sys.exit(precommit_fix())
PYEOF
        rc=$?
    fi
    if [ "$rc" -ne 0 ]; then
        cat >&2 <<EOF
pre-commit: a local orca_core override is staged in $override and could not be
stripped automatically.

A relative path only resolves on your machine; a clone without a sibling
orca_core cannot install at all. Unstage it and commit the rest:

    git restore --staged pyproject.toml uv.lock

or bypass with --no-verify if you are certain the commit is clean.
EOF
        exit 1
    fi
fi

# --- frontend bundle ---------------------------------------------------------
# The built frontend (orca_ui/webui/) is committed to git so npm-less machines
# can run the UI from a plain checkout. Committing frontend sources without a
# rebuilt bundle would ship a stale UI to every clone.

echo "$staged" | grep -Eq '^frontend/(src/|public/|index\.html|package(-lock)?\.json|vite\.config\.ts|tsconfig)' || exit 0
echo "$staged" | grep -q '^orca_ui/webui/' && exit 0

cat >&2 <<'EOF'
pre-commit: frontend sources are staged but orca_ui/webui/ is unchanged.
The committed bundle would be stale on other machines. Rebuild and stage it:

    cd frontend && npm run build && cd ..
    git add orca_ui/webui

or bypass this check with --no-verify if the bundle really is current.
EOF
exit 1
