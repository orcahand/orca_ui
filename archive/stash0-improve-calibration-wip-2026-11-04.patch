diff --git a/tests/test_guided_tension_presenter.py b/tests/test_guided_tension_presenter.py
index 14f3e64..7849eda 100644
--- a/tests/test_guided_tension_presenter.py
+++ b/tests/test_guided_tension_presenter.py
@@ -57,3 +57,54 @@ def test_rounds_count_on_from_the_saved_progress():
     fresh = _Ctx()
     _Presenter(fresh, {}).progress({"event": "step", "step": "pose", "round": 1})
     assert fresh.extra["round"] == 1
+
+
+class _Hand:
+    def __init__(self, config):
+        self.config = config
+        self.writes = []
+
+    def set_max_current(self, current):
+        self.writes.append(current)
+
+
+def _live_op(step):
+    import glob
+    import os
+
+    import orca_core
+    from orca_core.hand_config import OrcaHandConfig
+
+    from orca_ui.hand.operations.guided_tension import GuidedTensionOperation
+
+    path = sorted(glob.glob(os.path.join(os.path.dirname(orca_core.__file__), "models", "v2", "*-right",
+                                         "config.yaml")))[0]
+    op = GuidedTensionOperation({"defaults": {"hold_ap": 200.0, "hold_mcp": 140.0, "hold_pip": 100.0,
+                                              "tension_current": 400.0, "tension_offset_deg": 10.0}})
+    op._hand = _Hand(OrcaHandConfig.from_config_path(config_path=path))
+    op._presenter = _Presenter(_Ctx(), op.settings())
+    op._presenter.progress({"event": "step", "step": step, "round": 1, "stage": hand_ops.range_stages()[1],
+                            "stage_index": 1, "stage_count": 4})
+    return op
+
+
+def test_a_saved_hold_current_reaches_the_stage_and_keeps_the_rest_frozen():
+    op = _live_op("range")
+    assert op.handle_input("current:hold_mcp=600")
+    config = op._hand.config
+    by_joint = dict(zip((config.motor_to_joint_dict.get(m) for m in config.motor_ids), op._hand.writes[-1]))
+    assert by_joint["middle_mcp"] == 600.0
+    assert by_joint["middle_pip"] == 100.0
+    assert by_joint["index_mcp"] == by_joint["ring_mcp"] == 400.0
+
+    assert op.handle_input("current:tension_current=500")
+    by_joint = dict(zip((config.motor_to_joint_dict.get(m) for m in config.motor_ids), op._hand.writes[-1]))
+    assert by_joint["index_mcp"] == 500.0 and by_joint["middle_mcp"] == 600.0
+
+
+def test_a_saved_current_waits_for_the_step_that_uses_it():
+    op = _live_op("tension")
+    op.handle_input("current:hold_mcp=300")
+    assert op._hand.writes == []
+    op.handle_input("current:tension_current=700")
+    assert op._hand.writes == [700.0]
